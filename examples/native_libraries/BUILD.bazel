load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_library", "kt_jvm_test")
load(":run_tool.bzl", "run_tool")

kt_jvm_library(
    name = "native_library",
    srcs = ["Native.kt"],
    runtime_deps = ["@native_dep//:native"],
)

kt_jvm_test(
    name = "native_test",
    main_class = "Native",
    test_class = "Native",
    runtime_deps = [":native_library"],
)

kt_jvm_binary(
    name = "native_binary",
    main_class = "Native",
    runtime_deps = [":native_library"],
)

# Runs the binary in an action, from the execroot.
run_tool(
    name = "native_binary_output",
    tool = ":native_binary",
)
