load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//src/main/starlark/release:packager.bzl", "release_archive")

toolchain_type(
    name = "toolchain_type",
    visibility = [
        "//visibility:public",
    ],
)

# Keep registration separate from the CLI implementation's compiler loads.
toolchain(
    name = "cli_toolchain",
    toolchain = "//src/main/starlark/core/compile/cli:cli_toolchain",
    toolchain_type = ":toolchain_type",
)

bzl_library(
    name = "compile",
    srcs = [
        "common.bzl",
    ],
    visibility = [
        "//visibility:public",
    ],
)

release_archive(
    name = "pkg",
    srcs = ["common.bzl"],
    src_map = {
        "BUILD.release.bazel": "BUILD.bazel",
    },
    deps = [],
)
