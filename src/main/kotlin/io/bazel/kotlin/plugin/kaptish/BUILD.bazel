load("@rules_java//java:defs.bzl", "java_library", "java_plugin")

# The kaptish javac compiler-plugin library (Java to access internal javac APIs).
# Registered as a com.sun.source.util.Plugin service so javac loads it via -Xplugin:Kaptish.
java_library(
    name = "kaptish-lib",
    srcs = ["KotlinClassInjectorPlugin.java"],
    javacopts = [
        "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    ],
    resource_strip_prefix = "src/main/kotlin/io/bazel/kotlin/plugin/kaptish",
    resources = ["META-INF/services/com.sun.source.util.Plugin"],
    visibility = ["//src:__subpackages__"],
)

# java_plugin (no processor_class) to provide JavaPluginInfo so java_common.compile places the
# jar on javac's -processorpath, where javac's ServiceLoader discovers the -Xplugin. It runs as
# a javac Plugin (via -Xplugin:Kaptish), NOT as an annotation processor.
java_plugin(
    name = "kaptish",
    visibility = ["//visibility:public"],
    deps = [":kaptish-lib"],
)
