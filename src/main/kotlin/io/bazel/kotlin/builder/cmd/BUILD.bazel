load("//kotlin/compiler:compiler.bzl", _KOTLIN_STDLIBS = "KOTLIN_STDLIBS")
load(
    "//src/main/kotlin:bootstrap.bzl",
    "kt_bootstrap_library",
    "kt_bootstrap_worker_jar",
    "kt_bootstrap_worker_launcher",
)

kt_bootstrap_library(
    name = "build_lib",
    srcs = ["Build.kt"],
    visibility = ["//src:__subpackages__"],
    deps = [
        "//src/main/kotlin/io/bazel/kotlin/builder/tasks",
        "//src/main/kotlin/io/bazel/kotlin/builder/toolchain",
        "//src/main/kotlin/io/bazel/worker",
        "//src/main/protobuf:kotlin_model_java_proto",
        "@com_google_protobuf//:protobuf_java",
    ],
)

kt_bootstrap_library(
    name = "merge_jdeps_lib",
    srcs = ["MergeJdepsMain.kt"],
    visibility = ["//src:__subpackages__"],
    deps = [
        "//src/main/kotlin/io/bazel/kotlin/builder/tasks",
        "//src/main/kotlin/io/bazel/worker",
    ],
)

kt_bootstrap_library(
    name = "ksp2_lib",
    srcs = ["Ksp2.kt"],
    visibility = ["//src:__subpackages__"],
    deps = [
        "//src/main/kotlin/io/bazel/kotlin/builder/tasks",
        "//src/main/kotlin/io/bazel/worker",
    ],
)

# ONE reusable shaded busybox LIBRARY carrying all three worker mains + the worker framework +
# builder tasks + BOTH SPI plugins (with MERGED META-INF/services).
# Consumed via runtime_deps by the three thin launchers below.
# NOTE: the io.bazel.kotlin.ksp2 invoker (//src/main/kotlin/io/bazel/kotlin/ksp2:ksp2) is
# deliberately NOT folded here; folding the UNRELOCATED invoker onto the ksp2 launcher's
# system/parent classloader shadows KSP's child-side load (NoClassDefFoundError). The fold +
# relocation + --processor_classpath repoint land together in step 2 (mol-7u1).
kt_bootstrap_worker_jar(
    name = "busybox",
    shade_rules = "//src/main/kotlin:shade.jarjar",
    visibility = ["//src:__subpackages__"],
    deps = [
        ":build_lib",
        ":merge_jdeps_lib",
        ":ksp2_lib",
        "//src/main/kotlin/io/bazel/kotlin/plugin:skip-code-gen-lib",
        "//src/main/kotlin/io/bazel/kotlin/plugin:skip-code-gen-services",
        "//src/main/kotlin/io/bazel/kotlin/plugin/jdeps:jdeps-gen-lib",
        "//src/main/kotlin/io/bazel/kotlin/plugin/jdeps:jdeps-gen-services",
        "@bazel_tools//tools/jdk:JacocoCoverage",
    ],
)

kt_bootstrap_worker_launcher(
    name = "build",
    data = [
        "//kotlin/compiler:jvm-abi-gen",
        "//kotlin/compiler:kotlin-annotation-processing",
        "//kotlin/compiler:kotlin-compiler",
        "//src/main/kotlin:jdeps-gen",
        "//src/main/kotlin:skip-code-gen",
        "//src/main/kotlin/io/bazel/kotlin/compiler:compiler.jar",
        "@com_github_jetbrains_kotlin//:home",
        "@kotlin_build_tools_api//file",
    ] + _KOTLIN_STDLIBS,
    final_runtime_deps = _KOTLIN_STDLIBS,
    jvm_flags = [
        "-D@com_github_jetbrains_kotlin...build-tools-api=$(rlocationpath @kotlin_build_tools_api//file)",
        "-D@com_github_jetbrains_kotlin...jvm-abi-gen=$(rlocationpath //kotlin/compiler:jvm-abi-gen)",
        "-D@com_github_jetbrains_kotlin...kotlin-compiler=$(rlocationpath //kotlin/compiler:kotlin-compiler)",
        "-D@com_github_jetbrains_kotlin...kotlin-stdlib=$(rlocationpath //kotlin/compiler:kotlin-stdlib)",
        "-D@com_github_jetbrains_kotlin...kapt=$(rlocationpath //kotlin/compiler:kotlin-annotation-processing)",
        "-D@rules_kotlin...jdeps-gen=$(rlocationpath //src/main/kotlin:jdeps-gen)",
        "-D@rules_kotlin...skip-code-gen=$(rlocationpath //src/main/kotlin:skip-code-gen)",
        "-D@rules_kotlin...compiler=$(rlocationpath //src/main/kotlin/io/bazel/kotlin/compiler:compiler.jar)",
        "-D@rules_kotlin..kotlin.compiler.kotlin-reflect=$(rlocationpath //kotlin/compiler:kotlin-reflect)",
        "-XX:-MaxFDLimit",
        "-XX:+IgnoreUnrecognizedVMOptions",
        "--add-opens=java.base/java.nio=ALL-UNNAMED",
        "--add-opens=java.base/java.lang=ALL-UNNAMED",
        "--add-opens=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED",
        "--add-opens=jdk.jdeps/com.sun.tools.jdeps=ALL-UNNAMED",
    ],
    main_class = "io.bazel.kotlin.builder.cmd.Build",
    visibility = ["//src:__subpackages__"],
    worker_jar = ":busybox",
)

kt_bootstrap_worker_launcher(
    name = "merge_jdeps",
    data = _KOTLIN_STDLIBS,
    final_runtime_deps = _KOTLIN_STDLIBS,
    jvm_flags = [],
    main_class = "io.bazel.kotlin.builder.cmd.MergeJdepsMain",
    visibility = ["//src:__subpackages__"],
    worker_jar = ":busybox",
)

kt_bootstrap_worker_launcher(
    name = "ksp2",
    data = _KOTLIN_STDLIBS,
    final_runtime_deps = _KOTLIN_STDLIBS,
    jvm_flags = [],
    main_class = "io.bazel.kotlin.builder.cmd.Ksp2",
    visibility = ["//src:__subpackages__"],
    worker_jar = ":busybox",
)
