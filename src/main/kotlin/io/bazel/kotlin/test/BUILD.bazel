load("//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")

kt_jvm_library(
    name = "test_base",
    testonly = True,
    srcs = ["BazelIntegrationTestBase.kt"],
    visibility = ["//src:__subpackages__"],
    deps = [
        "@bazel_tools//tools/java/runfiles",
        "@kotlin_rules_maven//:org_apache_commons_commons_compress",
    ],
)

filegroup(
    name = "internal_jars",
    srcs = ["//:release_metadata"],
    output_group = "jars",
)

kt_jvm_test(
    name = "BazelIntegrationTestRunner",
    srcs = [
        "BazelIntegrationTestRunner.kt",
    ],
    data = [
        ":internal_jars",
        "//:rules_kotlin_release",
    ],
    jvm_flags = [
        "-D@rules_kotlin...internal_jars='$(rlocationpaths :internal_jars)'",
        "-D@rules_kotlin...rules_kotlin_release=$(rlocationpath //:rules_kotlin_release)",
    ],
    # Run through bazel_integration_test, which supplies Bazel and the workspace.
    tags = ["manual"],
    test_class = "io.bazel.kotlin.test.BazelIntegrationTestRunner",
    visibility = [
        "//visibility:public",
    ],
    deps = [
        ":test_base",
        "//src/main/kotlin/io/bazel/kotlin/generate",
        "@kotlin_rules_maven_test//:junit_junit",
    ],
)
