load("//kotlin:core.bzl", "kt_ksp_plugin")
load("//kotlin:jvm.bzl", "kt_jvm_library")
load(":ksp_test.bzl", "ksp_conflicting_options_test", ksp_test_suite = "test_suite")

ksp_test_suite(name = "ksp_tests")

# Two KSP plugins that share the same option key -- used to test conflict detection. Kept on
# @bazel_skylib//lib:unittest.bzl (see ksp_test.bzl's test_suite docstring): case.bzl's
# case()/claim() API has no equivalent to analysistest.make(..., expect_failure=True).
kt_ksp_plugin(
    name = "moshi_plugin_with_option_a",
    options = {"shared_key": "value_from_a"},
    processor_class = "com.squareup.moshi.kotlin.codegen.ksp.JsonClassSymbolProcessorProvider",
    deps = [
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi",
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi_kotlin",
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi_kotlin_codegen",
    ],
)

kt_ksp_plugin(
    name = "moshi_plugin_with_option_b",
    options = {"shared_key": "value_from_b"},
    processor_class = "com.squareup.moshi.kotlin.codegen.ksp.JsonClassSymbolProcessorProvider",
    deps = [
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi",
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi_kotlin",
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi_kotlin_codegen",
    ],
)

# Tagged manual so it is not analyzed by wildcard builds; the analysis test below pulls it in via
# target_under_test.
kt_jvm_library(
    name = "ksp_test_lib_with_conflicting_options",
    srcs = ["TestModel.kt"],
    plugins = [
        ":moshi_plugin_with_option_a",
        ":moshi_plugin_with_option_b",
    ],
    tags = ["manual"],
    deps = [
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi",
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi_kotlin",
    ],
)

ksp_conflicting_options_test(
    name = "ksp_conflicting_options_test",
    target_under_test = ":ksp_test_lib_with_conflicting_options",
)
