load("//kotlin:core.bzl", "kt_kotlinc_options")
load("//kotlin:jvm.bzl", "kt_jvm_test")

kt_kotlinc_options(
    name = "jvm11_opts",
    jvm_target = "11",
)

kt_jvm_test(
    name = "WriteKotlincCapabilitiesTest",
    srcs = [
        "WriteKotlincCapabilitiesTest.kt",
    ],
    kotlinc_opts = ":jvm11_opts",
    test_class = "io.bazel.kotlin.generate.WriteKotlincCapabilitiesTest",
    deps = [
        "//src/main/kotlin/io/bazel/kotlin/generate",
        "@kotlin_rules_maven_test//:com_google_truth_truth",
    ],
)

kt_jvm_test(
    name = "GenerateReleaseMetadataTest",
    srcs = ["GenerateReleaseMetadataTest.kt"],
    data = ["//docs/templates:release_notes.txt.template"],
    jvm_flags = [
        "-Dnotes.template=$(location //docs/templates:release_notes.txt.template)",
    ],
    test_class = "io.bazel.kotlin.generate.GenerateReleaseMetadataTest",
    deps = [
        "//src/main/kotlin/io/bazel/kotlin/generate",
        "@kotlin_rules_maven_test//:com_google_truth_truth",
    ],
)
